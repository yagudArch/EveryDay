# deploy/staging.env.example — OPS-002 staging configuration template.
#
# Copy to a secret store or the runner's protected env; NEVER commit a filled copy.
# Every value is read by apps/backend/src/env.ts. Secrets live server-side only —
# the mobile client never receives AI keys (AI_PROVIDER stays server-side).

# --- HTTP listener (behind the TLS terminator, see deploy/staging-nginx.conf) ---
# The Node process listens on loopback; nginx/Caddy terminates HTTPS in front of it.
HOST=127.0.0.1
PORT=3000

# TRUST_PROXY must be true in staging so rate-limit/IP logic reads X-Forwarded-For
# from the trusted reverse proxy (and ONLY from it).
TRUST_PROXY=true

# --- Database ---
# Absolute path on the staging host; the parent dir must be writable by the service user.
DATABASE_PATH=/var/lib/everyday/everyday.db
MIGRATIONS_DIR=/opt/everyday/database/migrations

# --- CORS: explicit HTTPS allowlist only. Never "*" in staging/production. ---
CORS_ORIGINS=https://staging.everyday.example

# --- Rate limiting (per-process, in-memory; see PostgreSQL note for multi-instance) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ENTRIES=10000

# --- AI provider: stays "disabled" until AI-001 wires a real provider with
# operator-supplied server-side credentials + privacy review. ---
AI_PROVIDER=disabled
# AI_API_KEY is injected by the secret store at deploy time, never committed.
# AI_API_KEY=__set_via_secret_store__

# --- Backups (scripts/backup-sqlite.mjs) ---
BACKUP_DIR=/var/backups/everyday
BACKUP_KEEP=14

NODE_ENV=production
LOG_LEVEL=info
