# Backend environment (apps/backend). Copy to .env for local runs; never commit secrets.
# All values are optional — the defaults below are the actual development defaults.

# HTTP listener. Binds to loopback only unless HOST is overridden on purpose.
HOST=127.0.0.1
PORT=3000

# File-backed relational SQLite database (node:sqlite).
# Relative paths are resolved against the repository root. ":memory:" disables persistence (tests only).
DATABASE_PATH=data/everyday.db

# Versioned SQL migration directory (relative paths resolve against the repository root).
MIGRATIONS_DIR=database/migrations

# Comma-separated CORS allowlist. "*" reflects any origin and is development-only.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000

# Rate limiting is per-process and in-memory (bounded, fixed window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ENTRIES=10000

# AI provider. Foundation ships the disabled provider only: POST /api/v1/ai/parse
# answers with an explicit 503 instead of a fabricated preview.
# The AI owner (FND-004 / AI-001) wires a real provider here; credentials stay server-side.
AI_PROVIDER=disabled

NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false
